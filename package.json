		"react-i18next": "17.0.8"
	},
	"devDependencies": {
		"@types/node": "24.12.3",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"husky": "9.1.7",
		"i18next-parser": "^9.4.0",
		"oxlint": "1.68.0",
